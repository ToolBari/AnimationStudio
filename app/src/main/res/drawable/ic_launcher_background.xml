<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- base diagonal brand gradient -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="2"
                android:endX="104"
                android:endY="108"
                android:startColor="#7A1FF2"
                android:centerColor="#9A4DFF"
                android:endColor="#03DAC6" />
        </aapt:attr>
    </path>

    <!-- soft radial glow centered behind the glyph -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="56"
                android:startColor="#2EFFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- glossy diagonal sheen across the upper-left -->
    <path
        android:pathData="M-10,30 L48,-10 L70,-10 L-10,58 Z"
        android:fillColor="#14FFFFFF" />
    <path
        android:pathData="M-10,66 L78,-10 L92,-10 L-10,82 Z"
        android:fillColor="#0AFFFFFF" />

    <!-- gentle vignette for depth at the edges -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="78"
                android:startColor="#00000000"
                android:endColor="#22000000" />
        </aapt:attr>
    </path>
</vector>
